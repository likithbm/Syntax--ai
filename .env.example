# Copy to .env to override defaults. Everything runs locally: no API keys, no cloud services.
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5vl:3b

# Seconds to wait for the single vision request (a 3B vision model on CPU can be slow)
VISION_TIMEOUT=300

# Where the SQLite history lives
DB_PATH=data/syntax_ai.db

# Upload limits / image preparation
MAX_IMAGE_MB=8
MAX_IMAGE_SIDE=1280

# Verification time limits (seconds)
COMPILE_TIMEOUT=30
RUN_TIMEOUT=5
